# Copia este archivo como .env y cambia los valores.
# .env está ignorado por Git: nunca lo subas al repositorio.
#
# Este archivo lo usa docker-compose.yml para crear el MySQL local.
# Spring Boot no lee .env automáticamente: exporta DB_USER y DB_PASSWORD
# en tu terminal o configúralas en IntelliJ.

# --- Aplicación Spring Boot ---
DB_USER=clinica
DB_PASSWORD=cambia_esta_clave_de_la_app

# --- Contenedor MySQL ---
MYSQL_DATABASE=clinica_dental
MYSQL_USER=clinica
MYSQL_PASSWORD=cambia_esta_clave_de_la_app
MYSQL_ROOT_PASSWORD=cambia_esta_clave_de_root
